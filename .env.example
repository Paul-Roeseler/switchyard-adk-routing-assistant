# Short-lived Google Cloud OAuth token used by Vertex AI generation and embeddings.
# Generate with: gcloud auth application-default print-access-token
VERTEX_ACCESS_TOKEN=

# NVIDIA Inference Hub key used by the classifier and simple target.
INFERENCE_HUB_API=

# Nebius Token Factory key used by the medium target.
NEBIUS_API_KEY=

# The ADK model client calls this local Switchyard OpenAI endpoint.
SWITCHYARD_BASE_URL=http://127.0.0.1:4000/v1
