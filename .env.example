# Short-lived Google Cloud OAuth bearer token used by the strong Gemini Pro tier.
# Generate with: gcloud auth application-default print-access-token
VERTEX_ACCESS_TOKEN=

# NVIDIA Inference Hub key used by the classifier, weak tier, and optional Opus tier.
INFERENCE_HUB_API=

# Google Cloud project used by Vertex generation and embeddings.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
