# Gemini Developer API key used by the simple tier.
GOOGLE_API=

# NVIDIA Inference Hub key used by the classifier and complex tier.
INFERENCE_HUB_API=

# Vertex AI project used for document embeddings. Authentication uses ADC.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# The ADK model client calls this local Switchyard OpenAI endpoint.
SWITCHYARD_BASE_URL=http://127.0.0.1:4000/v1
