# Gemini Developer API key used by the complex and reasoning tiers.
GOOGLE_API=

# NVIDIA Inference Hub key used by the classifier, simple, and medium tiers.
INFERENCE_HUB_API=

# Optional model overrides for the four routing tiers.
SWITCHYARD_SIMPLE_MODEL=nvidia/meta/llama-3.1-8b-instruct
SWITCHYARD_MEDIUM_MODEL=nvidia/zai-org/glm-5.2
SWITCHYARD_COMPLEX_MODEL=gemini-3.6-flash
SWITCHYARD_REASONING_MODEL=gemini-3.1-pro-preview

# Optional classifier override. By default it uses the medium model.
# SWITCHYARD_CLASSIFIER_MODEL=nvidia/zai-org/glm-5.2

# Vertex AI project used for document embeddings. Authentication uses ADC.
GOOGLE_CLOUD_PROJECT=model-routing-505414
GOOGLE_CLOUD_LOCATION=global

# The ADK model client calls this local Switchyard OpenAI endpoint.
SWITCHYARD_BASE_URL=http://127.0.0.1:4000/v1
